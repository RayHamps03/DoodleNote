@model DoodleNoteDetailsViewModel
@{
    ViewData["Title"] = Model.NoteTitle;
    ViewData["BodyClass"] = "bg-black text-white";
    ViewData["ContainerClass"] = "container-fluid p-0";
}

<div class="row justify-content-center m-0">
    <div class="col-12 col-md-10 col-lg-8" style="background-color: #252525; border-left: 5px solid; border-right: 5px solid; border-image: linear-gradient(to bottom, #323232 0%, #C8C8C8 50%, #323232 100%) 1; padding: 15px; min-height: 100vh;">
        <h1>@Model.NoteTitle</h1>
        <div class="mb-2 text-muted">Created: @Model.CreatedDate.ToString("yyyy-MM-dd")</div>
<div class="mb-2"><strong>Author:</strong> @Model.Author</div>

@if (!string.IsNullOrWhiteSpace(Model.ImagePath))
{
    <div class="mb-4 text-center">
        <img src="@Url.Content(Model.ImagePath)" alt="Doodle image for @Model.NoteTitle" class="img-fluid rounded border mx-auto d-block" style="max-height: 420px; background-color: #FFFFFF;" />
    </div>
}

<div class="mb-3">
    <label class="form-label">Description</label>
            <div id="note-description" class="form-control" style="min-height: 80px; background: linear-gradient(to top, #181818 0%, #1E1E1E 100%);">@Model.Description</div>
</div>

<div class="flex items-center gap-3">
    <form asp-controller="DoodleNotes" asp-action="ToggleNoteLike" method="post">
        <input type="hidden" name="NoteId" value="@Model.NoteId" />
        <button type="submit" class="btn @(Model.IsLikedByCurrentUser ? "btn-primary" : "btn-outline-primary")">
            @if (Model.IsLikedByCurrentUser)
            {
                <span aria-hidden="true">&#9829;</span>
                <span>Liked</span>
            }
            else
            {
                <span aria-hidden="true">&#9825;</span>
                <span>Like</span>
            }
            <span class="badge bg-secondary ms-1">@Model.LikeCount</span>
        </button>
    </form>
</div>

<section class="mt-4" aria-labelledby="comments-heading">
    <h2 id="comments-heading" class="h5 mb-3">
        Comments
        <span class="badge bg-secondary ms-1">@Model.Comments.Count</span>
    </h2>

    <form asp-controller="DoodleNotes" asp-action="AddComment" method="post" class="mb-4">
        @Html.AntiForgeryToken()
        <input type="hidden" name="noteId" value="@Model.NoteId" />
        <div class="mb-2">
            <label for="new-comment" class="form-label">Add a comment</label>
            <textarea id="new-comment"
                      name="commentText"
                      class="form-control"
                      style="background: linear-gradient(to top, #323232 0%, #787878 100%); color: #FFFFFF;"
                      rows="3"
                      maxlength="300"
                      placeholder="Write your comment..."
                      required></textarea>
        </div>
        <div class="d-flex justify-content-between align-items-center">
            <small class="text-muted">Up to 300 characters.</small>
            <button type="submit" class="btn btn-primary">Post comment</button>
        </div>
    </form>

    @if (Model.Comments.Count == 0)
    {
        <p class="text-muted">No comments yet. Be the first to comment.</p>
    }
    else
    {
        <ul class="list-unstyled mb-0">
            @foreach (var comment in Model.Comments)
            {
                <li class="mb-3 pb-3 border-bottom">
                    <div class="fw-semibold">@comment.Author</div>
                    <div class="text-muted small mb-1">#@comment.CommentId</div>
                    <div class="text-break">@comment.CommentText</div>
                </li>
            }
        </ul>
    }
</section>

            <a class="btn btn-secondary" asp-action="Index">Back to List</a>
        </div>
    </div>


